# Copy this file to ".env" and fill in your own values.
# Do NOT commit your real .env (it is git-ignored).

# --- Convex Value options-flow API (required) -------------------------------
# Source of all volmbs (net aggressor volume) data.
# Every user must supply their own Convex Value login with API access.
# These are placeholders; no working credentials are included.
# The app does not load .env automatically. See README Configuration.
CONVEX_EMAIL='you@example.com'
CONVEX_PASSWORD='your-convex-password'
CONVEX_ENV=live              # "live" or "pro"

# --- Optional: SPX ledger database location ---------------------------------
# Defaults to ../pg_database_spx.db relative to the package if unset.
# SPX_LEDGER_DB=/path/to/pg_database_spx.db

# --- UI theme (optional) -----------------------------------------------------
DAYTRADE_UI_THEME=dark       # "dark" or "light"
